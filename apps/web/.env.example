# ── Supabase (login + projects) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Cadastral explorer (Karnataka parcels) ───────────────────────────────────
# Service on port 8011; needs FLAGS=feature.cadastral.land-records on the backend.
NEXT_PUBLIC_ENABLE_CADASTRAL_EXPLORER=0
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011

# Local dev ONLY: skip Supabase login (stub user). Build-time flag; never set in deployed envs.
NEXT_PUBLIC_DEV_BYPASS_AUTH=0
